doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/admin.css")
    link(rel="stylesheet", href="/css/reservations.css")
    link(
      rel="stylesheet",
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    )

  body
    .admin-container
      // Sidebar
      nav.sidebar
        //- h2.logo Fusion Forkhouse Dashboard
        h2.logo
          img(src="/images/logo.png", alt="Fusion Forkhouse Logo", height="100")
        ul.nav-links
          li
            a(href="/admin")
              i.fa-solid.fa-house
              | Dashboard
          li
            a(href="/admin/menu")
              i.fa-solid.fa-utensils
              | Menu
          li
            a(href="/admin/reservations")
              i.fa-solid.fa-calendar-check
              | Reservations
          li
            a(href="/admin/contact")
              i.fa-solid.fa-envelope
              | Contact Messages
          //- li
          //-   a(href="/admin/reviews")
          //-     i.fa-solid.fa-star
          //-     | Reviews

      // Right side content and footer
      main.main-content
        section.content
          block content

        //footer content
        footer.admin-footer
          p
            | &copy; #{new Date().getFullYear()} Fusion Forkhouse Admin Dashboard — All Rights Reserved
          p
            | Designed with 
            i.fa-solid.fa-heart(style="color:#fff; margin:0 4px;")
            |  by Manpreet Kaur
