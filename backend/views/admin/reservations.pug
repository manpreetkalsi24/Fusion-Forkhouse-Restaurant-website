extends ../layout

block content
  h1 Reservations Management

  if reservations.length === 0
    p No reservations found.

  else
    table
      thead
        tr
          th Name
          th Email
          th Date
          th Time
          th Guests
          th Special Requests
          th Status
          th Action

      tbody
        each r in reservations
          tr
            td #{r.firstName} #{r.lastName}
            td= r.email
            td= r.date
            td= r.time
            td= r.guests
            td= r.specialRequests ? r.specialRequests : "—"
            td(class=`status ${r.status.toLowerCase()}`)= r.status
            td
              if r.status === "Pending"

                // Approve form
                form(method="POST" action=`/admin/reservations/approve/${r._id}` style="display:inline")
                  button(type="submit" class="approve-btn") Approve

                // Decline form
                form(method="POST" action=`/admin/reservations/decline/${r._id}` style="display:inline")
                  button(type="submit" class="decline-btn") Decline

              else
                span No action