extends ../layout

block content
  h1 Contact Messages

  if messages.length === 0
    p No messages found.
  else
    table
      thead
        tr
          th Name
          th Email
          th Message
          th Date

      tbody
        each msg in messages
          tr
            td #{msg.firstName} #{msg.lastName}
            td= msg.email
            td= msg.message
            td= msg.createdAt.toDateString()