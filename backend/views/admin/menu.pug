extends ../layout

block content
  .menu-header
    h1 Menu Management
    a.add-btn(href="/admin/menu/add") Add New Item

  table.menu-table
    thead
      tr
        th Image
        th Name
        th Category
        th Price
        th Actions

    tbody
      if menuItems.length === 0
        tr
          td(colspan="6") No menu items found.

      each item in menuItems
        tr
          td
            if item.image
              img(src=item.image width="70")
            else
              span No Image

          td= item.name
          td.category= item.category
          td.price $#{item.price}

          td
            a.edit-btn(href=`/admin/menu/edit/${item._id}`) Edit

            form(method="POST" action=`/admin/menu/delete/${item._id}` style="display:inline")
                button.delete-btn(type="submit" onclick="return confirm('Are you sure you want to delete this item?')") Delete
            
  